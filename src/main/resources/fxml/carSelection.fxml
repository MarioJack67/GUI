               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <Label alignment="CENTER" focusTraversable="false" layoutX="147.0" layoutY="39.0" prefHeight="27.0" prefWidth="305.0" text="Select a Car for this Parking Spot" AnchorPane.leftAnchor="147.0" AnchorPane.rightAnchor="148.33333333333337" AnchorPane.topAnchor="39.0">
