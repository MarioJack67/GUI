      <VBox alignment="CENTER" layoutX="220.0" layoutY="200.0" prefHeight="46.0" prefWidth="160.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="220.0" AnchorPane.topAnchor="200.0">
